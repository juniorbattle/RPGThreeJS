# VFX GIF Preview Bridge — Local Dev Configuration
#
# Copy this file to .env.local and set MEGA_PACK_ROOT to your local
# CartoonCoffeeMegaPack directory.
#
# .env.local is machine-local and must NEVER be committed.
#
# After creating .env.local, simply run:
#   npm run dev
#
# No manual PowerShell environment setup is required.
#
# Use forward slashes to avoid Windows escape ambiguity:
MEGA_PACK_ROOT=C:/path/to/CartoonCoffeeMegaPack
